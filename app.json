{
  "expo": {
    "name": "NutriTeens",
    "slug": "nutriteens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/mascot/icon-app.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img/mascot/icon-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/mascot/icon-app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nutriteens.nutriteens"
    },
    "web": {
      "favicon": "./assets/img/mascot/icon-app.png"
    },
    "scheme": "nutriteens",
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "164a0816-3be5-4d3e-b295-a38cf7e188ec"
      }
    },
    "owner": "nutriteens"
  }
}
