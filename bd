-- ---- registros_atividade_fisica: dono via registros_diarios.user_id ----
ALTER TABLE public.registros_atividade_fisica ENABLE ROW LEVEL SECURITY;

CREATE POLICY "registros_atividade_fisica: usuário vê e edita os próprios"
    ON public.registros_atividade_fisica FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.registros_diarios rd
            WHERE rd.id = registros_atividade_fisica.registro_diario_id
            AND rd.user_id = auth.uid()
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM public.registros_diarios rd
            WHERE rd.id = registros_atividade_fisica.registro_diario_id
            AND rd.user_id = auth.uid()
        )
    );

-- ---- refeicoes: dono via recordatorio (EBIA/nutricional) OU via registro_diario ----
ALTER TABLE public.refeicoes ENABLE ROW LEVEL SECURITY;

CREATE POLICY "refeicoes: usuário vê e edita as próprias"
    ON public.refeicoes FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.recordatorios_alimentares ra
            JOIN public.avaliacoes_nutricionais an ON an.id = ra.avaliacao_nutricional_id
            WHERE ra.id = refeicoes.recordatorio_id
            AND an.user_id = auth.uid()
        )
        OR
        EXISTS (
            SELECT 1 FROM public.registros_diarios rd
            WHERE rd.id = refeicoes.registro_diario_id
            AND rd.user_id = auth.uid()
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM public.recordatorios_alimentares ra
            JOIN public.avaliacoes_nutricionais an ON an.id = ra.avaliacao_nutricional_id
            WHERE ra.id = refeicoes.recordatorio_id
            AND an.user_id = auth.uid()
        )
        OR
        EXISTS (
            SELECT 1 FROM public.registros_diarios rd
            WHERE rd.id = refeicoes.registro_diario_id
            AND rd.user_id = auth.uid()
        )
    );

-- ---- feedbacks_nutricionais: dono via refeicoes (mesma lógica acima) ----
ALTER TABLE public.feedbacks_nutricionais ENABLE ROW LEVEL SECURITY;

CREATE POLICY "feedbacks_nutricionais: usuário vê os próprios"
    ON public.feedbacks_nutricionais FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.refeicoes r
            LEFT JOIN public.recordatorios_alimentares ra ON ra.id = r.recordatorio_id
            LEFT JOIN public.avaliacoes_nutricionais an ON an.id = ra.avaliacao_nutricional_id
            LEFT JOIN public.registros_diarios rd ON rd.id = r.registro_diario_id
            WHERE r.id = feedbacks_nutricionais.refeicao_id
            AND (an.user_id = auth.uid() OR rd.user_id = auth.uid())
        )
    );

-- ---- alimentos: catálogo compartilhado — todo usuário autenticado pode LER,
--      só o backend (service_role) pode escrever ----
ALTER TABLE public.alimentos ENABLE ROW LEVEL SECURITY;

CREATE POLICY "alimentos: leitura liberada para autenticados"
    ON public.alimentos FOR SELECT
    USING (auth.role() = 'authenticated');

-- ---- refeicao_alimentos: dono via refeicoes (mesma lógica) ----
ALTER TABLE public.refeicao_alimentos ENABLE ROW LEVEL SECURITY;

CREATE POLICY "refeicao_alimentos: usuário vê e edita os próprios"
    ON public.refeicao_alimentos FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.refeicoes r
            LEFT JOIN public.recordatorios_alimentares ra ON ra.id = r.recordatorio_id
            LEFT JOIN public.avaliacoes_nutricionais an ON an.id = ra.avaliacao_nutricional_id
            LEFT JOIN public.registros_diarios rd ON rd.id = r.registro_diario_id
            WHERE r.id = refeicao_alimentos.refeicao_id
            AND (an.user_id = auth.uid() OR rd.user_id = auth.uid())
        )
    );