-- =====================================================================
-- SCHEMA NUTRITEENS — VERSÃO CORRIGIDA
-- Rodar de uma vez só no SQL Editor do Supabase (Project > SQL Editor > New query)
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. TIPOS ENUMERADOS
-- ---------------------------------------------------------------------
CREATE TYPE enum_papel_usuario AS ENUM ('ADOLESCENTE', 'NUTRICIONISTA', 'ADMINISTRADOR');

-- FILANTROPICA adicionada aqui (o SignupScreen já oferece essa opção no rádio)
CREATE TYPE enum_tipo_instituicao AS ENUM ('PUBLICA', 'PRIVADA', 'FILANTROPICA');

CREATE TYPE enum_classificacao_ebia AS ENUM ('SEGURANCA', 'INSEGURANCA_LEVE', 'INSEGURANCA_MODERADA', 'INSEGURANCA_GRAVE');
CREATE TYPE enum_tipo_refeicao AS ENUM ('CAFE_DA_MANHA', 'ALMOCO', 'LANCHE_TARDE', 'JANTAR', 'CEIA');
CREATE TYPE enum_classificacao_nova AS ENUM ('IN_NATURA', 'INGREDIENTE_CULINARIO', 'PROCESSADO', 'ULTRAPROCESSADO');
CREATE TYPE enum_nivel_qualidade AS ENUM ('EXCELENTE', 'EQUILIBRADO', 'ATENCAO_ULTRAPROCESSADO');

-- ordem mantida como estava (decisão de UI, não afeta o banco)
CREATE TYPE enum_etapa_onboarding AS ENUM ('CADASTRO', 'TRIAGEM', 'APRESENTACAO', 'ORIENTACOES', 'CONCLUIDO');

-- período coberto pela avaliação nutricional (usado em avaliacoes_nutricionais.periodo_tempo)
-- ASSUNÇÃO: valores de exemplo — como o banco ainda não foi rodado, é fácil ajustar
-- os rótulos abaixo antes de rodar, sem precisar de migração depois.
CREATE TYPE enum_tempo_avaliacao AS ENUM ('SEMANAL', 'QUINZENAL', 'MENSAL', 'TRIMESTRAL');

-- grupos alimentares fixos (usado em alimentos.grupos_alimentares)
-- ASSUNÇÃO: baseado nos grupos do Guia Alimentar para a População Brasileira —
-- ajuste os rótulos se o time de nutrição tiver uma lista própria antes de rodar.
CREATE TYPE enum_grupo_alimentar AS ENUM (
    'CEREAIS_E_TUBERCULOS',
    'LEGUMES_E_VERDURAS',
    'FRUTAS',
    'LEITE_E_DERIVADOS',
    'CARNES_E_OVOS',
    'LEGUMINOSAS',
    'OLEAGINOSAS_E_SEMENTES',
    'OLEOS_E_GORDURAS',
    'ACUCARES_E_DOCES',
    'BEBIDAS'
);

-- ---------------------------------------------------------------------
-- 2. PERFIL (VINCULADO AO AUTH.USERS DO SUPABASE)
-- ---------------------------------------------------------------------
CREATE TABLE public.profiles (
    id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
    nome TEXT NOT NULL,
    data_nascimento DATE NOT NULL,
    papel enum_papel_usuario DEFAULT 'ADOLESCENTE'::enum_papel_usuario,
    codigo_participante TEXT UNIQUE,
    instituicao_ensino TEXT,
    tipo_instituicao enum_tipo_instituicao,
    classificacao_ebia_atual enum_classificacao_ebia,
    etapa_onboarding enum_etapa_onboarding NOT NULL DEFAULT 'CADASTRO',
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- ---------------------------------------------------------------------
-- 3. CONSENTIMENTOS
--    Adicionada a coluna `conteudo` para bater com o UML
--    (guarda o texto do termo que o usuário efetivamente aceitou)
-- ---------------------------------------------------------------------
CREATE TABLE public.consentimentos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    aceite_termos BOOLEAN NOT NULL DEFAULT TRUE,
    data_aceite TIMESTAMPTZ DEFAULT NOW(),
    versao_termo TEXT NOT NULL,
    conteudo TEXT NOT NULL
);

-- ---------------------------------------------------------------------
-- 4. AVALIAÇÕES NUTRICIONAIS (AGREGADOR)
-- ---------------------------------------------------------------------
CREATE TABLE public.avaliacoes_nutricionais (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    data_realizacao TIMESTAMPTZ DEFAULT NOW(),
    concluida BOOLEAN DEFAULT FALSE,
    periodo_tempo enum_tempo_avaliacao,
    atualizado_em TIMESTAMPTZ DEFAULT NOW()
);

-- mantém atualizado_em em dia sozinho a cada UPDATE nesta tabela
-- (função genérica: reutilizável em qualquer outra tabela que precisar do mesmo controle)
CREATE OR REPLACE FUNCTION set_atualizado_em()
RETURNS TRIGGER AS $$
BEGIN
    NEW.atualizado_em := NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_atualizado_em_avaliacoes_nutricionais
    BEFORE UPDATE ON public.avaliacoes_nutricionais
    FOR EACH ROW
    EXECUTE FUNCTION set_atualizado_em();

-- ---------------------------------------------------------------------
-- 5. AVALIAÇÃO EBIA (1:1 obrigatória com avaliacoes_nutricionais)
--    pontuacao_total e classificacao agora são opcionais (NULL até concluir a triagem)
-- ---------------------------------------------------------------------
CREATE TABLE public.avaliacoes_ebia (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    avaliacao_nutricional_id UUID NOT NULL UNIQUE REFERENCES public.avaliacoes_nutricionais(id) ON DELETE CASCADE,
    pontuacao_total INT,
    classificacao enum_classificacao_ebia,
    concluido BOOLEAN DEFAULT FALSE
);

-- ---------------------------------------------------------------------
-- 5.1 RESPOSTAS INDIVIDUAIS DA EBIA (cada pergunta, salva incrementalmente)
-- ---------------------------------------------------------------------
CREATE TABLE public.respostas_ebia (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    avaliacao_ebia_id UUID NOT NULL REFERENCES public.avaliacoes_ebia(id) ON DELETE CASCADE,
    numero_pergunta INT NOT NULL,
    resposta BOOLEAN NOT NULL,
    CONSTRAINT unique_pergunta_ebia UNIQUE (avaliacao_ebia_id, numero_pergunta)
);

-- ---------------------------------------------------------------------
-- 6. RECORDATÓRIO ALIMENTAR DE 24H
-- ---------------------------------------------------------------------
CREATE TABLE public.recordatorios_alimentares (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    avaliacao_nutricional_id UUID NOT NULL REFERENCES public.avaliacoes_nutricionais(id) ON DELETE CASCADE,
    data_referencia DATE NOT NULL,
    concluido BOOLEAN DEFAULT FALSE
);

-- ---------------------------------------------------------------------
-- 7. REGISTRO DIÁRIO (HÁBITOS)
-- ---------------------------------------------------------------------
CREATE TABLE public.registros_diarios (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
    data DATE NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    CONSTRAINT unique_user_data UNIQUE (user_id, data)
);

-- ---------------------------------------------------------------------
-- 8. REGISTROS DE ÁGUA
-- ---------------------------------------------------------------------
CREATE TABLE public.registros_agua (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    registro_diario_id UUID NOT NULL REFERENCES public.registros_diarios(id) ON DELETE CASCADE,
    quantidade_ml INT NOT NULL,
    horario_registro TIME NOT NULL
);

-- ---------------------------------------------------------------------
-- 9. REGISTROS DE ATIVIDADE FÍSICA
-- ---------------------------------------------------------------------
CREATE TABLE public.registros_atividade_fisica (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    registro_diario_id UUID NOT NULL REFERENCES public.registros_diarios(id) ON DELETE CASCADE,
    tipo_atividade TEXT NOT NULL,
    duracao_minutos INT NOT NULL,
    quantidade_passos INT,
    horario_registro TIME NOT NULL
);

-- ---------------------------------------------------------------------
-- 10. REFEIÇÕES (REUTILIZÁVEL ENTRE RECORDATÓRIO E REGISTRO DIÁRIO)
-- ---------------------------------------------------------------------
CREATE TABLE public.refeicoes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    recordatorio_id UUID REFERENCES public.recordatorios_alimentares(id) ON DELETE CASCADE,
    registro_diario_id UUID REFERENCES public.registros_diarios(id) ON DELETE CASCADE,
    tipo enum_tipo_refeicao NOT NULL,
    realizada BOOLEAN NOT NULL DEFAULT TRUE,
    horario_registro TIME,
    CONSTRAINT check_origem_refeicao CHECK (
        (recordatorio_id IS NOT NULL AND registro_diario_id IS NULL) OR
        (recordatorio_id IS NULL AND registro_diario_id IS NOT NULL)
    )
);

-- ---------------------------------------------------------------------
-- 11. FEEDBACK NUTRICIONAL QUALITATIVO
-- ---------------------------------------------------------------------
CREATE TABLE public.feedbacks_nutricionais (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    refeicao_id UUID UNIQUE NOT NULL REFERENCES public.refeicoes(id) ON DELETE CASCADE,
    mensagem_educativa TEXT NOT NULL,
    nivel_qualidade enum_nivel_qualidade NOT NULL,
    data_geracao TIMESTAMPTZ DEFAULT NOW()
);

-- ---------------------------------------------------------------------
-- 12. CATÁLOGO MESTRE DE ALIMENTOS (compartilhado, não é dado do usuário)
-- ---------------------------------------------------------------------
CREATE TABLE public.alimentos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    nome TEXT NOT NULL,
    eh_prato_composto BOOLEAN DEFAULT FALSE,
    classificacao_nova enum_classificacao_nova NOT NULL,
    acessivel_ebia BOOLEAN DEFAULT TRUE,
    grupos_alimentares enum_grupo_alimentar[] NOT NULL
);

-- ---------------------------------------------------------------------
-- 13. JUNÇÃO: REFEIÇÃO <-> ALIMENTOS (N:M)
-- ---------------------------------------------------------------------
CREATE TABLE public.refeicao_alimentos (
    refeicao_id UUID NOT NULL REFERENCES public.refeicoes(id) ON DELETE CASCADE,
    alimento_id UUID NOT NULL REFERENCES public.alimentos(id) ON DELETE RESTRICT,
    PRIMARY KEY (refeicao_id, alimento_id)
);

-- =====================================================================
-- 14. GERAÇÃO AUTOMÁTICA DO CÓDIGO DE PARTICIPANTE (NT-000001, NT-000002...)
--
-- Como funciona, em 3 partes:
--   a) uma SEQUENCE é só um contador no banco que sempre avança
--      (1, 2, 3...), nunca repete, mesmo com cadastros simultâneos.
--   b) a função abaixo pega o próximo número dessa sequence e formata
--      como texto (ex: 7 -> "NT-000007").
--   c) o TRIGGER roda essa função automaticamente ANTES de cada
--      INSERT em profiles, preenchendo codigo_participante sozinho.
--
-- Quer um formato mais simples? É só trocar a linha do RETURN:
--   - sem zero à esquerda:      RETURN 'NT-' || nextval('seq_...')::text;
--   - outro prefixo:            troque 'NT-' pelo que quiser
-- =====================================================================
CREATE SEQUENCE seq_codigo_participante START 1;

CREATE OR REPLACE FUNCTION gerar_codigo_participante()
RETURNS TRIGGER AS $$
BEGIN
    NEW.codigo_participante := 'NT-' || LPAD(nextval('seq_codigo_participante')::text, 6, '0');
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_codigo_participante
    BEFORE INSERT ON public.profiles
    FOR EACH ROW
    EXECUTE FUNCTION gerar_codigo_participante();

-- =====================================================================
-- 15. ROW LEVEL SECURITY (RLS)
--
-- Sem isso, qualquer usuário autenticado pode ler/editar dados de
-- qualquer outro usuário via API do Supabase. Cada tabela abaixo
-- só libera acesso ao dono da informação.
-- =====================================================================

-- ---- profiles: dono é o próprio id ----
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;

CREATE POLICY "profiles: usuário vê e edita o próprio perfil"
    ON public.profiles FOR ALL
    USING (auth.uid() = id)
    WITH CHECK (auth.uid() = id);

-- ---- consentimentos: dono via user_id ----
ALTER TABLE public.consentimentos ENABLE ROW LEVEL SECURITY;

CREATE POLICY "consentimentos: usuário vê e edita os próprios"
    ON public.consentimentos FOR ALL
    USING (auth.uid() = user_id)
    WITH CHECK (auth.uid() = user_id);

-- ---- avaliacoes_nutricionais: dono via user_id ----
ALTER TABLE public.avaliacoes_nutricionais ENABLE ROW LEVEL SECURITY;

CREATE POLICY "avaliacoes_nutricionais: usuário vê e edita as próprias"
    ON public.avaliacoes_nutricionais FOR ALL
    USING (auth.uid() = user_id)
    WITH CHECK (auth.uid() = user_id);

-- ---- avaliacoes_ebia: dono via avaliacoes_nutricionais.user_id ----
ALTER TABLE public.avaliacoes_ebia ENABLE ROW LEVEL SECURITY;

CREATE POLICY "avaliacoes_ebia: usuário vê e edita as próprias"
    ON public.avaliacoes_ebia FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_nutricionais an
            WHERE an.id = avaliacoes_ebia.avaliacao_nutricional_id
            AND an.user_id = auth.uid()
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_nutricionais an
            WHERE an.id = avaliacoes_ebia.avaliacao_nutricional_id
            AND an.user_id = auth.uid()
        )
    );

-- ---- respostas_ebia: dono via avaliacoes_ebia -> avaliacoes_nutricionais ----
ALTER TABLE public.respostas_ebia ENABLE ROW LEVEL SECURITY;

CREATE POLICY "respostas_ebia: usuário vê e edita as próprias"
    ON public.respostas_ebia FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_ebia ae
            JOIN public.avaliacoes_nutricionais an ON an.id = ae.avaliacao_nutricional_id
            WHERE ae.id = respostas_ebia.avaliacao_ebia_id
            AND an.user_id = auth.uid()
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_ebia ae
            JOIN public.avaliacoes_nutricionais an ON an.id = ae.avaliacao_nutricional_id
            WHERE ae.id = respostas_ebia.avaliacao_ebia_id
            AND an.user_id = auth.uid()
        )
    );

-- ---- recordatorios_alimentares: dono via avaliacoes_nutricionais.user_id ----
ALTER TABLE public.recordatorios_alimentares ENABLE ROW LEVEL SECURITY;

CREATE POLICY "recordatorios_alimentares: usuário vê e edita os próprios"
    ON public.recordatorios_alimentares FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_nutricionais an
            WHERE an.id = recordatorios_alimentares.avaliacao_nutricional_id
            AND an.user_id = auth.uid()
        )
    )
    WITH CHECK (
        EXISTS (
            SELECT 1 FROM public.avaliacoes_nutricionais an
            WHERE an.id = recordatorios_alimentares.avaliacao_nutricional_id
            AND an.user_id = auth.uid()
        )
    );

-- ---- registros_diarios: dono via user_id ----
ALTER TABLE public.registros_diarios ENABLE ROW LEVEL SECURITY;

CREATE POLICY "registros_diarios: usuário vê e edita os próprios"
    ON public.registros_diarios FOR ALL
    USING (auth.uid() = user_id)
    WITH CHECK (auth.uid() = user_id);

-- ---- registros_agua: dono via registros_diarios.user_id ----
ALTER TABLE public.registros_agua ENABLE ROW LEVEL SECURITY;

CREATE POLICY "registros_agua: usuário vê e edita os próprios"
    ON public.registros_agua FOR ALL
    USING (
        EXISTS (
            SELECT 1 FROM public.registros_diarios rd
            WHERE rd.id = registros_agua.registro_diario_id
